{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ucsb-amplab.github.io/zasqua/schemas/v1.1/vocabulary.schema.json",
  "x-contract-version": "1.1",
  "title": "Zasqua vocabulary.json — Data Contract v1.1",
  "description": "JSON Schema draft-07 for the optional vocabulary file: the labels of entity types, place types, roles and authority sources. An entry that is no longer recommended carries \"deprecated\": true; approved entries omit the member. Field meanings are in docs/data-contract.md.",
  "definitions": {
    "bilingual": {
      "type": "object",
      "description": "Text in each language, keyed by language code (es, en). A member may be null; the field counts as empty when every member is.",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "type": "object",
  "properties": {
    "entity_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/bilingual"
          },
          "deprecated": {
            "const": true
          }
        }
      }
    },
    "place_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/bilingual"
          },
          "deprecated": {
            "const": true
          },
          "external": {
            "type": "object",
            "required": [
              "uri"
            ],
            "properties": {
              "scheme": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "uri": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "role_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/bilingual"
          },
          "deprecated": {
            "const": true
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "entity_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/bilingual"
          },
          "deprecated": {
            "const": true
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "place_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/bilingual"
          },
          "deprecated": {
            "const": true
          }
        }
      }
    },
    "authority_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "$ref": "#/definitions/bilingual"
          },
          "deprecated": {
            "const": true
          },
          "url_template": {
            "type": ["string", "null"]
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
